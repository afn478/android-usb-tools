<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.afn478.AndroidUSBTools.tethering</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/rndis-tether</string>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>io.github.afn478.AndroidUSBTools</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart after crashes, but not after a clean exit (e.g. the app was deleted). -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardErrorPath</key>
    <string>/var/log/rndis-tether.log</string>
</dict>
</plist>
